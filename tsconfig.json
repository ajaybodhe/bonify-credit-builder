{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* Language & emit — Node 22+ native ESM, no bundler in the loop. */
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": false,

    /* Correctness. `strict` is the TS 6 default; kept explicit so the intent
       survives a downgrade or a reader who does not know the new defaults. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,

    /* Unused code is a lint concern, not a build failure — see eslint.config.js. */
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    /* Single-file transpilation safety: tsx and vitest both compile per-file. */
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src", "tests", "*.config.ts", "drizzle.config.ts"]
}
