{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm ci)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx vitest:*)",
      "Bash(npx drizzle-kit:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(jq:*)",
      "Bash(curl -sS http://localhost:3000/*)",
      "Bash(curl -sS localhost:3000/*)",
      "Bash(curl -sS https://btq03nn21b.execute-api.eu-central-1.amazonaws.com/*)",
      "Bash(psql -h localhost -p 5433:*)",
      "Bash(/Applications/Postgres.app/Contents/Versions/17/bin/psql -h localhost -p 5433:*)"
    ],
    "ask": [
      "Bash(docker compose down:*)",
      "Bash(npm run db:reset)",
      "Bash(dropdb:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Bash(curl:*BANKING_API_KEY*)"]
  }
}
