# Copy to .env and fill in. `.env` is gitignored — never commit the API key.
#   cp .env.example .env

# ---- Service ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# ---- Banking API (upstream) ----
# Note: the assignment brief writes `BANKING_API_BASE_URL==https://...` with a
# doubled `=`. That is a typo in the brief; the value is the single URL below.
BANKING_API_BASE_URL=https://btq03nn21b.execute-api.eu-central-1.amazonaws.com
BANKING_API_KEY=replace-me
BANKING_API_TIMEOUT_MS=10000
BANKING_API_MAX_RETRIES=3

# ---- Database ----
# Matches docker-compose.yml. Override host/port if you point at your own Postgres.
# Set to true ONLY when a proxy in front rewrites X-Forwarded-For. Left false,
# the rate limiter keys on the real socket address and a spoofed header cannot
# move it.
TRUST_PROXY=false

DATABASE_URL=postgres://credit:credit@localhost:5433/credit_builder
DATABASE_POOL_MAX=10

# ---- Scoring ----
# The model version is intentionally NOT configurable. It lives in MODEL_VERSION
# in src/modules/reliability/scoring.ts, because it describes the code that ran,
# not the deployment — a snapshot must never record a version that never ran.

# ---- Observability (OpenTelemetry) ----
# Telemetry is opt-in: with no endpoint set, the SDK does not start and the
# service emits nothing. Point this at a collector to turn all three pillars on.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=credit-builder
