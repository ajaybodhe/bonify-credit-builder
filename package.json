{
  "name": "bonify-credit-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Explainable Reliability Index (0-100) for thin-file users, computed from synced bank transaction data.",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "setup": "./scripts/setup.sh",
    "dev": "tsx watch --import ./src/telemetry/register.ts --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import ./dist/telemetry/register.js --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "check": "run-s typecheck lint format:check test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:studio": "drizzle-kit studio",
    "db:reset": "docker compose down -v && docker compose up -d && npm run db:migrate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prepare": "husky || true",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:contract": "vitest run --project contract",
    "test:all": "vitest run --project unit --project integration --project e2e"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@fastify/otel": "^0.20.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.0",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "npm-run-all2": "^9.0.3",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
